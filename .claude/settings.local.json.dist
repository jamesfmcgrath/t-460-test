{
  "permissions": {
    "allow": [
      "Read(<absolute-path-to-repo>/**)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(ddev drush:*)",
      "Bash(ddev composer:*)",
      "Bash(ddev exec vendor/bin/phpcs {{MODULE_PATH}})",
      "Bash(ddev exec vendor/bin/phpcbf {{MODULE_PATH}})",
      "Bash(ddev exec vendor/bin/phpstan analyse {{MODULE_PATH}})",
      "Bash(ddev exec vendor/bin/phpunit -c web/core {{MODULE_PATH}})",
      "Bash(ddev exec vendor/bin/phpcs web/modules/custom)",
      "Bash(ddev exec vendor/bin/phpcs web/themes/custom)",
      "Bash(ddev exec vendor/bin/phpcbf web/modules/custom)",
      "Bash(ddev exec vendor/bin/phpcbf web/themes/custom)",
      "Bash(ddev exec vendor/bin/phpstan analyse web/modules/custom)",
      "Bash(ddev exec vendor/bin/phpstan analyse web/themes/custom)",
      "Bash(ddev exec vendor/bin/phpunit -c web/core web/modules/custom)",
      "Bash(ddev exec vendor/bin/phpunit -c web/core web/themes/custom)",
      "Bash(make lint)",
      "Bash(make lint-fix)",
      "Bash(make stan)",
      "Bash(make test)",
      "Bash(make check)",
      "Bash(make format)",
      "Bash(make format-check)"
    ]
  }
}
